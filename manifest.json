{
  "manifest_version": 3,
  "name": "B站首页拦截器",
  "version": "1.2.2",
  "description": "打开 B 站首页时拦下来；新标签页打开就直接关掉。视频、个人空间、搜索等页面不受影响。开关可随时暂停，也能把拦截改成跳转到自己指定的网址，并设置不拦截的星期。",
  "minimum_chrome_version": "102",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://bilibili.com/*",
    "*://*.bilibili.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "B站首页拦截器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
